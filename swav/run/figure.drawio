        <mxCell id="sA" value="s&lt;sub&gt;1&lt;/sub&gt; = z&lt;sub&gt;1&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; C&lt;br&gt;1 × 3000 scores" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="730" y="76" width="115" height="64" as="geometry" /></mxCell>
        <mxCell id="sB" value="s&lt;sub&gt;2&lt;/sub&gt; = z&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; C&lt;br&gt;1 × 3000 scores" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="730" y="344" width="115" height="64" as="geometry" /></mxCell>
        <mxCell id="sC" value="s&lt;sub&gt;v&lt;/sub&gt; = z&lt;sub&gt;v&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; C&lt;br&gt;1 × 3000 scores" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="115" height="64" as="geometry" /></mxCell>

        <mxCell id="pA" value="p&lt;sub&gt;1&lt;/sub&gt; = softmax(s&lt;sub&gt;1&lt;/sub&gt; / τ)&lt;br&gt;τ = 0.1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="76" width="140" height="64" as="geometry" /></mxCell>
        <mxCell id="skB" value="Sinkhorn-Knopp&lt;br&gt;3 iterations, ε = 0.05&lt;br&gt;code q&lt;sub&gt;2&lt;/sub&gt; of crop x&lt;sub&gt;2&lt;/sub&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF3F9;strokeColor=#2E74B5;fontColor=#1F4E79;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="170" width="140" height="62" as="geometry" /></mxCell>
        <mxCell id="skA" value="Sinkhorn-Knopp&lt;br&gt;3 iterations, ε = 0.05&lt;br&gt;code q&lt;sub&gt;1&lt;/sub&gt; of crop x&lt;sub&gt;1&lt;/sub&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF3F9;strokeColor=#2E74B5;fontColor=#1F4E79;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="252" width="140" height="62" as="geometry" /></mxCell>
        <mxCell id="pB" value="p&lt;sub&gt;2&lt;/sub&gt; = softmax(s&lt;sub&gt;2&lt;/sub&gt; / τ)&lt;br&gt;τ = 0.1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="344" width="140" height="64" as="geometry" /></mxCell>
        <mxCell id="pC" value="p&lt;sub&gt;v&lt;/sub&gt; = softmax(s&lt;sub&gt;v&lt;/sub&gt; / τ)&lt;br&gt;v = 3 … 8" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="470" width="140" height="64" as="geometry" /></mxCell>

        <mxCell id="loss1" value="− Σ&lt;sub&gt;k&lt;/sub&gt; q&lt;sub&gt;2k&lt;/sub&gt; log p&lt;sub&gt;1k&lt;/sub&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#3C4350;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="145" width="140" height="20" as="geometry" /></mxCell>
        <mxCell id="loss2" value="− Σ&lt;sub&gt;k&lt;/sub&gt; q&lt;sub&gt;1k&lt;/sub&gt; log p&lt;sub&gt;2k&lt;/sub&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#3C4350;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="875" y="319" width="140" height="20" as="geometry" /></mxCell>
        <mxCell id="loss3" value="− Σ&lt;sub&gt;k&lt;/sub&gt; q&lt;sub&gt;1k&lt;/sub&gt; log p&lt;sub&gt;vk&lt;/sub&gt; − Σ&lt;sub&gt;k&lt;/sub&gt; q&lt;sub&gt;2k&lt;/sub&gt; log p&lt;sub&gt;vk&lt;/sub&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#3C4350;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="795" y="540" width="250" height="20" as="geometry" /></mxCell>

        <mxCell id="cap" value="Figure 1. SwAV pretraining as implemented in main_swav.py, commit 06b1b7c. One unlabelled image is cropped into two global views of 224 × 224 (RandomResizedCrop, scale 0.14 to 1.0) and six local views of 96 × 96 (scale 0.05 to 0.14). All eight crops run through the same ResNet-50 backbone and the same projection head, which is what the grey dashed links mean; the tapering silhouette is the spatial resolution, written in grey under each backbone, and the channel widths are the bold line beneath it. Each unit-norm embedding is scored against 3000 prototypes. The blue path runs under torch.no_grad: the scores of one global crop become a code through 3 Sinkhorn-Knopp iterations with ε = 0.05, and that code is placed beside the other crop's prediction, so each swapped cross-entropy term is written where the two boxes meet. Local crops are predicted from both codes and never produce one. Values are those of scripts/swav_800ep_pretrain.sh; the optional feature queue (queue_length &gt; 0) is not drawn." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#3C4350;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="30" y="586" width="1015" height="150" as="geometry" /></mxCell>
      <mxCell id="lgbg" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#DFE3E8;fontFamily=Times New Roman;" vertex="1" parent="legend"><mxGeometry x="0" y="0" width="880" height="32" as="geometry" /></mxCell>
        <mxCell id="lgl0" value="" style="html=1;endArrow=none;strokeColor=#1A1A1A;strokeWidth=1.8;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="16" as="sourcePoint" /><mxPoint x="38" y="16" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lgl1" value="" style="html=1;endArrow=none;strokeColor=#2E74B5;strokeWidth=1.8;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="16" as="sourcePoint" /><mxPoint x="192" y="16" as="targetPoint" /></mxGeometry></mxCell>
