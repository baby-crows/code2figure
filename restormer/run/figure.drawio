        <mxCell id="gann" value="(C/h) × (C/h)" style="text;html=1;fontFamily=Times New Roman;fontSize=16;align=center;verticalAlign=middle;fontColor=#3E4652;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="421" y="916" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="f1" value="1 × 1&lt;br&gt;conv" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#5B6472;fontFamily=Times New Roman;fontSize=16;fontColor=#3C4350;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="858" y="832" width="62" height="56" as="geometry"/></mxCell>
