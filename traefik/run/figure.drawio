<mxfile host="papertrail">
  <diagram name="traefik-architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" page="1" pageWidth="1340" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="zdata" value="Data path: the listener stays open across every reconfiguration" style="rounded=1;arcSize=4;fillColor=#eef3f9;strokeColor=#8aa4c0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#2b4c70;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="104" y="52" width="1010" height="254" as="geometry" />
        </mxCell>

        <mxCell id="zctrl" value="Control path: a complete new handler tree is built off the data path" style="rounded=1;arcSize=4;fillColor=#fdf6ec;strokeColor=#d99b4a;verticalAlign=top;align=right;spacingRight=14;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#8a520f;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="104" y="424" width="1010" height="320" as="geometry" />
        </mxCell>

        <mxCell id="title" value="Traefik: how a container label becomes a live route" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1a1a1a;fontFamily=Times New Roman;" vertex="1" parent="1">
