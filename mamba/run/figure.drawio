        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A1A1A;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="180" as="sourcePoint" /><mxPoint x="465" y="134" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="outc" value="output&lt;br&gt;(B, L, 2560)" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5B6472;fontSize=11;fontFamily=Times New Roman;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="90" width="260" height="44" as="geometry" /></mxCell>
        <mxCell id="outproj" value="Output projection: 5120 → 2560" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=12;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="gate" value="&lt;b&gt;Gated RMS norm&lt;/b&gt;&lt;br&gt;y = RMSNorm(y) · silu(z)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="340" height="50" as="geometry" /></mxCell>
        <mxCell id="eq1" value="h(t) = R(Θ(t)) · exp(A(t) Δ(t)) · h(t-1) + w(t) · x(t) B(t)^T" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="1"><mxGeometry x="160" y="396" width="620" height="18" as="geometry" /></mxCell>
        <mxCell id="eq2" value="y(t) = C(t) · h(t) + (D + γ(t) B(t)·C(t)) · x(t),   γ(t) = Δ(t) λ(t)" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="1"><mxGeometry x="160" y="418" width="620" height="18" as="geometry" /></mxCell>
        <mxCell id="sh1" value="" style="rounded=0;html=1;fillColor=#EEF1F5;strokeColor=#7C8798;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="206" y="464" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="sh2" value="" style="rounded=0;html=1;fillColor=#EEF1F5;strokeColor=#7C8798;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="426" y="464" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="sh3" value="" style="rounded=0;html=1;fillColor=#EEF1F5;strokeColor=#7C8798;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="646" y="464" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="h1" value="&lt;b&gt;h(t-1)&lt;/b&gt;&lt;br&gt;64 × 128" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="470" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="h2" value="&lt;b&gt;h(t)&lt;/b&gt;&lt;br&gt;64 × 128" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="h3" value="&lt;b&gt;h(t+1)&lt;/b&gt;&lt;br&gt;64 × 128" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="rlab" value="× R state copies" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=center;verticalAlign=middle;fontColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="180" y="530" width="160" height="18" as="geometry" /></mxCell>
        <mxCell id="rot" value="&lt;b&gt;Rotate B and C&lt;/b&gt;&lt;br&gt;by Θ(t), over 32&lt;br&gt;channel pairs&lt;br&gt;Θ(t) = Σ θ Δ mod 2π" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="590" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="dew" value="&lt;b&gt;Decay and input weight&lt;/b&gt;&lt;br&gt;decay = exp(A(t) Δ(t))&lt;br&gt;w(t) = Δ(t)λ(t) + Δ(t+1)(1 - λ(t+1))" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="bcn" value="&lt;b&gt;B and C&lt;/b&gt;&lt;br&gt;RMS norm,&lt;br&gt;then add a learned bias" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="emap" value="&lt;b&gt;Elementwise maps&lt;/b&gt;&lt;br&gt;Δ = softplus(· + b)   A = -heavy-tail(·), clamped&lt;br&gt;λ = sigmoid(·)   θ = π · tanh(·)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="690" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;z&lt;/b&gt;&lt;br&gt;gate&lt;br&gt;5120" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;x&lt;/b&gt;&lt;br&gt;value&lt;br&gt;5120" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="135" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;B&lt;/b&gt;&lt;br&gt;state write&lt;br&gt;128" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;C&lt;/b&gt;&lt;br&gt;state read&lt;br&gt;128" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=11;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Δ&lt;/b&gt;&lt;br&gt;step size&lt;br&gt;80" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s6" value="&lt;b&gt;A&lt;/b&gt;&lt;br&gt;decay&lt;br&gt;80" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="515" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s7" value="&lt;b&gt;λ&lt;/b&gt;&lt;br&gt;trapezoid&lt;br&gt;80" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="s8" value="&lt;b&gt;θ&lt;/b&gt;&lt;br&gt;angle&lt;br&gt;32" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=11;fontFamily=Times New Roman;fontColor=#8A5410;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="705" y="784" width="95" height="56" as="geometry" /></mxCell>
        <mxCell id="inproj" value="Input projection: one linear map, no bias.   2560 → 10768 channels" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontSize=12;fontFamily=Times New Roman;fontColor=#3E4652;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="inp" value="input tokens&lt;br&gt;u : (B, L, D = 2560)" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5B6472;fontSize=11;fontFamily=Times New Roman;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="930" width="260" height="44" as="geometry" /></mxCell>
        <mxCell id="cap" value="Figure 3. The Mamba-3 mixer block as implemented in mamba_ssm/modules/mamba3.py. One linear map projects each token into eight slices. Four of them are the feature path (z, x, B, C) and four are elementwise maps that become the parameters of the recurrence. B and C are RMS normalised, biased, and then rotated by the accumulated angle, so a state transition is a rotation followed by a data dependent decay. The input weight w(t) mixes step t with step t+1, which is the trapezoidal rule. Warm fill marks what this file adds over mamba2.py in the same repository: data dependent A, the rotation, the trapezoid weight, the normalised B and C, and the R parallel state copies of the MIMO variant (R = 4 with MIMO, R = 1 otherwise). The step size map softplus and the silu gate are carried over. Numbers are the default configuration d_model = 2560, d_state = 128, expand = 2, headdim = 64, giving 80 heads and 5120 inner channels. Only step t is drawn with its inputs; the same wiring repeats at every step. The block has no short convolution. Commit e9594ce." style="text;html=1;fillColor=none;fontFamily=Times New Roman;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4350;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1070" width="820" height="130" as="geometry" /></mxCell>
        <mxCell id="lgbg" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#DFE3E8;fontFamily=Times New Roman;" vertex="1" parent="legend"><mxGeometry x="0" y="0" width="820" height="54" as="geometry" /></mxCell>
        <mxCell id="lgl3" value="" style="html=1;endArrow=none;strokeColor=#1A1A1A;strokeWidth=1.8;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="554" y="17" as="sourcePoint" /><mxPoint x="578" y="17" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lgl4" value="" style="html=1;endArrow=none;strokeColor=#C0392B;strokeWidth=2.2;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="41" as="sourcePoint" /><mxPoint x="38" y="41" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lgl5" value="" style="html=1;endArrow=none;strokeColor=#D08A2C;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="41" as="sourcePoint" /><mxPoint x="308" y="41" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lgl6" value="" style="html=1;endArrow=none;strokeColor=#8A93A0;strokeWidth=1.8;dashed=1;dashPattern=3 4;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="554" y="41" as="sourcePoint" /><mxPoint x="578" y="41" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lgs1" value="" style="rounded=0;html=1;fillColor=#FDF3E7;strokeColor=#D08A2C;fontFamily=Times New Roman;" vertex="1" parent="legend"><mxGeometry x="14" y="10" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="lgt1" value="introduced in Mamba-3" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="44" y="8" width="230" height="18" as="geometry" /></mxCell>
        <mxCell id="lgs2" value="" style="rounded=0;html=1;fillColor=#EEF1F5;strokeColor=#7C8798;fontFamily=Times New Roman;" vertex="1" parent="legend"><mxGeometry x="284" y="10" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="lgt2" value="carried over from Mamba-2" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="314" y="8" width="230" height="18" as="geometry" /></mxCell>
        <mxCell id="lgt3" value="feature flow" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="584" y="8" width="230" height="18" as="geometry" /></mxCell>
        <mxCell id="lgt4" value="recurrent state transition" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="44" y="32" width="230" height="18" as="geometry" /></mxCell>
        <mxCell id="lgt5" value="data-dependent parameter" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="314" y="32" width="230" height="18" as="geometry" /></mxCell>
        <mxCell id="lgt6" value="gate path" style="text;html=1;fillColor=none;fontFamily=Times New Roman;fontSize=11;align=left;verticalAlign=middle;fontColor=#3C4350;" vertex="1" parent="legend"><mxGeometry x="584" y="32" width="230" height="18" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
