        <mxCell id="Bcor" value="Corrector [runtime]&lt;br&gt;Langevin, snr = 0.16&lt;br&gt;1 step per timestep" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#5A87B8;fontColor=#1F3F66;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="228" y="406" width="176" height="72" as="geometry" /></mxCell>
