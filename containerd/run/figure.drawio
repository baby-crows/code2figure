        <mxCell id="lgs3" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#8a7f6a;html=1;fontFamily=Times New Roman;" vertex="1" parent="legend">
          <mxGeometry x="16" y="158" width="28" height="30" as="geometry" />
