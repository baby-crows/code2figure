          <mxGeometry x="506" y="622" width="66" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sa2" value="redis2" style="rounded=0;fillColor=#dceafa;strokeColor=#2b6cb0;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
