        <mxCell id="c_fh" value="Flatten + linear&lt;br&gt;42 · 128 = 5376 → 96&lt;br&gt;[trainable]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=12;fontColor=#7A4E10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="316" y="916" width="190" height="56" as="geometry"/></mxCell>
        <mxCell id="c_dn" value="RevIN denorm" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF3F9;strokeColor=#7C8798;fontSize=12;fontColor=#3E4652;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="556" y="928" width="120" height="32" as="geometry"/></mxCell>
        <mxCell id="c_out" value="Forecast&lt;br&gt;96 × 21" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D55;fontSize=12;fontColor=#22543D;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="726" y="916" width="110" height="56" as="geometry"/></mxCell>
        <mxCell id="c_enc1" value="Transformer encoder&lt;br&gt;[trainable]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=12;fontColor=#7A4E10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="96" y="792" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="c_enc2" value="Transformer encoder&lt;br&gt;[trainable]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=12;fontColor=#7A4E10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="96" y="916" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="c_ph" value="Linear 128 → P&lt;br&gt;one patch per token&lt;br&gt;[trainable]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF3E7;strokeColor=#D08A2C;fontSize=12;fontColor=#7A4E10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="316" y="792" width="176" height="56" as="geometry"/></mxCell>
        <mxCell id="c_rec" value="Reconstructed&lt;br&gt;patches" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D55;fontSize=12;fontColor=#22543D;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="542" y="792" width="136" height="56" as="geometry"/></mxCell>
        <mxCell id="c_loss" value="loss: MSE on masked patches" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#3C4350;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="700" y="810" width="246" height="20" as="geometry"/></mxCell>
        <mxCell id="cap" value="Figure 1. PatchTST on the weather benchmark (M = 21 channels, look-back L = 336, horizon T = 96; scripts/PatchTST/weather.sh). A look-back window is cut into N = 42 patches of length P = 16 at stride S = 8, so the Transformer attends over 42 tokens rather than 336 time steps, and consecutive windows overlap because S is smaller than P. The channel axis is then folded into the batch axis, so all 21 channels pass through one set of weights and no attention is ever computed across channels. The attention square in panel 2 is schematic: the matrix is 42 × 42 and is formed inside a single channel. The two rows of panel 3 are the same chain with one element changed, the head: fine-tuning copies every pre-trained weight except the head, so the dashed link runs from the encoder trained by reconstruction to the same encoder under the forecasting head. Every number is a default in the repository scripts; the self-supervised script has its own defaults (L = 512, P = S = 12, again N = 42). Repository commit 204c21efe0b39603ad6e2ca640ef5896646ab1a9." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#3C4350;whiteSpace=wrap;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="1024" width="950" height="100" as="geometry"/></mxCell>
