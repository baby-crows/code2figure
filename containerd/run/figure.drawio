        <mxCell id="title" value="containerd: how an image reference becomes a running container" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="20" y="6" width="780" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cres" value="3. Resolve the reference&#10;name to a manifest or index,&#10;then to layer descriptors" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#7f93ab;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="44" y="290" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cfet" value="4. Fetch and verify&#10;layer blobs by digest,&#10;then drive the unpack" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#7f93ab;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="44" y="390" width="202" height="76" as="geometry" />
        </mxCell>
        <mxCell id="dboot" value="1. daemon start: read &lt;font face=&quot;Courier New&quot;&gt;/etc/containerd/config.toml&lt;/font&gt;,&#10;register plugins, sort them by their Requires,&#10;init in that order" style="rounded=1;arcSize=8;fillColor=#dcefe4;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="318" y="104" width="512" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dapi" value="gRPC API on &lt;font face=&quot;Courier New&quot;&gt;containerd.sock&lt;/font&gt;&#10;images, containers, tasks&#10;plus the cri service for kubelet" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="318" y="214" width="246" height="86" as="geometry" />
        </mxCell>
        <mxCell id="dtask" value="8. Task service and shim manager&#10;&lt;font face=&quot;Courier New&quot;&gt;io.containerd.runtime.v2&lt;/font&gt;&#10;execs a shim, never runc" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="584" y="214" width="246" height="86" as="geometry" />
        </mxCell>
        <mxCell id="dcontent" value="5. Content store&#10;&lt;font face=&quot;Courier New&quot;&gt;io.containerd&#10;.content.v1&lt;/font&gt;&#10;blobs by digest" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="318" y="330" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dsnap" value="6. Snapshotter, differ&#10;&lt;font face=&quot;Courier New&quot;&gt;io.containerd&#10;.snapshotter.v1&lt;/font&gt;&#10;applies each layer" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dmeta" value="7. Metadata, leases&#10;&lt;font face=&quot;Courier New&quot;&gt;io.containerd&#10;.metadata.v1&lt;/font&gt;&#10;bolt graph, GC roots" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#2e7d55;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="682" y="330" width="148" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sshim" value="&lt;font face=&quot;Courier New&quot;&gt;containerd-shim-runc-v2&lt;/font&gt;&#10;ttrpc TaskService on&#10;&lt;font face=&quot;Courier New&quot;&gt;/run/containerd/s/[hash]&lt;/font&gt;&#10;outlives the daemon" style="rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#c07818;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="902" y="110" width="254" height="116" as="geometry" />
        </mxCell>
        <mxCell id="srunc" value="9. &lt;font face=&quot;Courier New&quot;&gt;runc&lt;/font&gt; [external]&#10;creates and starts&#10;the container" style="shape=hexagon;perimeter=hexagonPerimeter2;fillColor=#ffffff;strokeColor=#7a8085;dashed=1;dashPattern=8 5;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="926" y="272" width="206" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sproc" value="container process&#10;child of the shim,&#10;not of the daemon" style="rounded=1;arcSize=8;fillColor=#fdf0e6;strokeColor=#c07818;fontSize=14;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="902" y="392" width="254" height="76" as="geometry" />
        </mxCell>
        <mxCell id="rcont" value="content store&#10;&lt;font face=&quot;Courier New&quot;&gt;blobs/sha256/&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#8a7f6a;fontSize=14;verticalAlign=bottom;spacingBottom=6;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="318" y="566" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rmeta" value="metadata db&#10;&lt;font face=&quot;Courier New&quot;&gt;meta.db&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#8a7f6a;fontSize=14;verticalAlign=bottom;spacingBottom=6;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="682" y="566" width="148" height="110" as="geometry" />
        </mxCell>
