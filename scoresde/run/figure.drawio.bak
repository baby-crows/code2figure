        <mxCell id="A1" value="Data x(0)&lt;br&gt;3 × 32 × 32&lt;br&gt;CIFAR-10" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5B6472;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="52" y="150" width="126" height="76" as="geometry" /></mxCell>
        <mxCell id="A2" value="&lt;b&gt;Forward SDE&lt;/b&gt;  dx = f(x, t) dt + g(t) dw&lt;br&gt;VE:  f = 0,  g = σ(t) √(2 log(σmax / σmin))&lt;br&gt;VP:  f = -0.5 β(t) x,  g = √β(t)&lt;br&gt;sub-VP:  f = -0.5 β(t) x,  g = √(β(t) d(t))&lt;br&gt;σ: 0.01 → 50,  β: 0.1 → 20,  t ~ U[1e-5, 1]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEF1F5;strokeColor=#7C8798;fontColor=#3E4652;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="210" y="126" width="326" height="124" as="geometry" /></mxCell>
