        <mxCell id="A4" value="Noise z ~ N(0, I)&lt;br&gt;x(t) = mean + std z" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#F5F6F8;strokeColor=#8A93A0;fontColor=#6B7280;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="548" y="252" width="146" height="74" as="geometry" /></mxCell>
