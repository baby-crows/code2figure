        <mxCell id="client" value="client" style="shape=actor;html=1;fillColor=#ffffff;strokeColor=#5f6f80;verticalLabelPosition=bottom;verticalAlign=top;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="26" y="160" width="56" height="66" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;EntryPoint web&lt;/b&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;address: :80&lt;/font&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;listener.Accept()&lt;/font&gt;&#10;opened at start-up,&#10;before any route exists" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#5f6f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="128" y="132" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="128" y="96" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="&lt;b&gt;TCP router&lt;/b&gt;&#10;peeks the ClientHello,&#10;muxes on SNI, terminates&#10;TLS, forwards HTTP" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#5f6f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="348" y="132" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="2" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="348" y="96" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="&lt;b&gt;HTTP muxer and middlewares&lt;/b&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;Host(`whoami.docker.localhost`)&lt;/font&gt;&#10;chain: secure-headers, ip-allowlist" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#5f6f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="568" y="132" width="316" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="3" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="568" y="96" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="&lt;b&gt;Service load balancer&lt;/b&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;wrr | p2c | hrw&lt;/font&gt;&#10;health-checked pool,&#10;one server per request" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#5f6f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="904" y="132" width="186" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="4" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="904" y="96" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="lblb" value="[external]&#10;backend containers" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#5f6368;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="94" width="170" height="44" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;font face=&quot;Courier New&quot;&gt;traefik/whoami&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f7f7f7;strokeColor=#8a8a8a;dashed=1;dashPattern=8 5;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="144" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;font face=&quot;Courier New&quot;&gt;traefik/whoami&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f7f7f7;strokeColor=#8a8a8a;dashed=1;dashPattern=8 5;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="190" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="..." style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#8a8a8a;dashed=1;dashPattern=4 4;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="236" width="170" height="36" as="geometry" />
        </mxCell>

        <mxCell id="a8" value="&lt;b&gt;Handler switcher&lt;/b&gt; (&lt;font face=&quot;Courier New&quot;&gt;safe.Safe&lt;/font&gt;)&#10;one pointer store; applies to&#10;new connections only" style="rounded=0;fillColor=#dcefe4;strokeColor=#2e7d55;strokeWidth=3;align=center;verticalAlign=middle;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="8" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="288" y="352" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="7" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="128" y="460" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="6" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="416" y="460" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="&lt;b&gt;Providers&lt;/b&gt;&#10;each provider watches its own&#10;source and pushes a message&#10;onto one buffered channel&#10;&#10;&lt;font face=&quot;Courier New&quot;&gt;@docker, @kubernetes,&lt;/font&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;@file, ...&lt;/font&gt;&#10;throttled per provider" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#5f6f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="770" y="496" width="320" height="228" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="5" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;labelBackgroundColor=#1a1a1a;fontSize=17;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="770" y="460" width="30" height="28" as="geometry" />
        </mxCell>

        <mxCell id="lbls" value="[external]&#10;configuration sources" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#5f6368;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="444" width="170" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Docker daemon&#10;&lt;font face=&quot;Courier New&quot;&gt;docker.sock&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fillColor=#f7f7f7;strokeColor=#8a8a8a;dashed=1;dashPattern=8 5;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="496" width="170" height="58" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Kubernetes API" style="shape=hexagon;perimeter=hexagonPerimeter2;fillColor=#f7f7f7;strokeColor=#8a8a8a;dashed=1;dashPattern=8 5;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="570" width="170" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="file provider&#10;&lt;font face=&quot;Courier New&quot;&gt;dynamic.yml&lt;/font&gt;" style="shape=note;size=14;fillColor=#f7f7f7;strokeColor=#8a8a8a;dashed=1;dashPattern=8 5;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1134" y="638" width="170" height="58" as="geometry" />
        </mxCell>

        <mxCell id="cap" value="Figure 1. Traefik keeps two paths apart. (1) The entry point opens its listener at start-up, before any route exists, and never reopens it. (2) The TCP router peeks the TLS ClientHello, muxes on SNI&#10;and terminates TLS; (3) the HTTP muxer matches the router rule and runs the middleware chain; (4) the service load balancer forwards to one healthy backend. Meanwhile (5) each provider watches its own&#10;infrastructure and pushes a message onto one buffered channel, (6) the configuration watcher discards unchanged messages and merges the rest into a single configuration, and (7) the router factory&#10;builds a complete new handler tree. (8) A single pointer store swaps that tree in, so connections already open keep the previous one. Repository: eval/demo/sandbox/traefik; commit not determined." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5f6368;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="24" y="828" width="1280" height="84" as="geometry" />
        </mxCell>
      <mxCell id="c6b" value="apply: merges providers into&#10;one &lt;font face=&quot;Courier New&quot;&gt;dynamic.Configuration&lt;/font&gt;&#10;&lt;font face=&quot;Courier New&quot;&gt;routers, services, middlewares&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6ec;strokeColor=#d99b4a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=15;html=1;fontFamily=Times New Roman;" vertex="1" parent="c6">
          <mxGeometry x="10" y="122" width="310" height="76" as="geometry" />
        </mxCell>
