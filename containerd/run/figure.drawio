        <mxCell id="lgs5" value="1." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="legend">
