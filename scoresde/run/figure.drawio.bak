        <mxCell id="A6" value="sθ(x(t), t)&lt;br&gt;3 × 32 × 32" style="shape=note;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D55;fontSize=12;verticalAlign=middle;align=center;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="876" y="150" width="84" height="76" as="geometry" /></mxCell>
