        <mxCell id="lgl0" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1A1A1A;strokeWidth=1.8;fontFamily=Times New Roman;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="18" as="sourcePoint" /><mxPoint x="46" y="18" as="targetPoint" /></mxGeometry></mxCell>
